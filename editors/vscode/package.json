{
  "name": "geno-tools-tt-workspaces",
  "displayName": "Geno Tools: TT Workspaces",
  "description": "Browse and manage local and remote TT workspaces from VS Code.",
  "version": "0.3.4",
  "publisher": "42euge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "geno-tools",
    "tt",
    "workspace",
    "worktree",
    "remote ssh"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/42euge/geno-tools.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:genoTools.workspaces",
    "onView:genoTools.currentWorkspace",
    "onView:genoTools.remoteMirrors"
  ],
  "scripts": {
    "build": "node esbuild.js --production",
    "check": "tsc --noEmit",
    "dev": "node esbuild.js --watch",
    "test": "tsx --test src/test/*.test.ts",
    "package": "npm run check && npm test && npm run build && vsce package --no-dependencies"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "genoTools",
          "title": "Geno Tools",
          "icon": "resources/geno-tools.svg"
        }
      ]
    },
    "views": {
      "genoTools": [
        {
          "id": "genoTools.currentWorkspace",
          "name": "Current Workspace"
        },
        {
          "id": "genoTools.workspaces",
          "name": "All Workspaces"
        },
        {
          "id": "genoTools.remoteMirrors",
          "name": "Remote Mirrors"
        }
      ]
    },
    "commands": [
      {
        "command": "genoTools.refreshWorkspaces",
        "title": "Geno Tools: Rescan TT Workspaces",
        "icon": "$(refresh)"
      },
      {
        "command": "genoTools.refreshTerminals",
        "title": "Geno Tools: Refresh Open VS Code Terminals",
        "icon": "$(refresh)"
      },
      {
        "command": "genoTools.reloadWorkspaces",
        "title": "Geno Tools: Reload TT Workspace View"
      },
      {
        "command": "genoTools.createWorkspace",
        "title": "Geno Tools: Create TT Workspace",
        "icon": "$(add)"
      },
      {
        "command": "genoTools.createRepo",
        "title": "Geno Tools: Create Repository in Workspace",
        "icon": "$(add)"
      },
      {
        "command": "genoTools.createTmuxSession",
        "title": "Geno Tools: Create tmux Session in Workspace",
        "icon": "$(add)"
      },
      {
        "command": "genoTools.openTmuxSession",
        "title": "Geno Tools: Reopen tmux Session",
        "icon": "$(terminal-tmux)"
      },
      {
        "command": "genoTools.manageTmuxSession",
        "title": "Geno Tools: Manage tmux Session",
        "icon": "$(verified)"
      },
      {
        "command": "genoTools.restoreTmuxSession",
        "title": "Geno Tools: Restore tmux Session",
        "icon": "$(debug-restart)"
      },
      {
        "command": "genoTools.deleteTmuxSession",
        "title": "Geno Tools: Remove tmux Session",
        "icon": "$(trash)"
      },
      {
        "command": "genoTools.focusTerminal",
        "title": "Geno Tools: Focus VS Code Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "genoTools.recoverTerminalInTmux",
        "title": "Geno Tools: Recover Terminal in tmux with OpenAI",
        "icon": "$(robot)"
      },
      {
        "command": "genoTools.openWorkspace",
        "title": "Geno Tools: Open Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "genoTools.openWorkspaceInNewWindow",
        "title": "Geno Tools: Open Workspace in New Window",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "genoTools.openRepo",
        "title": "Geno Tools: Open Repository",
        "icon": "$(folder-opened)"
      },
      {
        "command": "genoTools.copyPath",
        "title": "Geno Tools: Copy Path"
      },
      {
        "command": "genoTools.mirrorWorkspace",
        "title": "Geno Tools: Mirror Workspace to Host",
        "icon": "$(remote)"
      },
      {
        "command": "genoTools.dispatchWorkspace",
        "title": "Geno Tools: Dispatch Workspace to Remote Host",
        "icon": "$(rocket)"
      },
      {
        "command": "genoTools.dispatchMirror",
        "title": "Geno Tools: Dispatch Work to This Mirror",
        "icon": "$(rocket)"
      },
      {
        "command": "genoTools.manageDispatches",
        "title": "Geno Tools: Manage Remote Dispatches",
        "icon": "$(list-tree)"
      },
      {
        "command": "genoTools.createWorktree",
        "title": "Geno Tools: Create Whole-Workspace Worktree"
      },
      {
        "command": "genoTools.listWorktrees",
        "title": "Geno Tools: List Whole-Workspace Worktrees"
      },
      {
        "command": "genoTools.removeWorktree",
        "title": "Geno Tools: Remove Whole-Workspace Worktree"
      },
      {
        "command": "genoTools.showReport",
        "title": "Geno Tools: Show Cross-Host TT Report"
      },
      {
        "command": "genoTools.showOutput",
        "title": "Geno Tools: Show TT Output"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "genoTools.createWorkspace",
          "when": "view == genoTools.workspaces",
          "group": "navigation@1"
        },
        {
          "command": "genoTools.createWorkspace",
          "when": "view == genoTools.currentWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "genoTools.refreshWorkspaces",
          "when": "view == genoTools.workspaces",
          "group": "navigation@2"
        },
        {
          "command": "genoTools.refreshWorkspaces",
          "when": "view == genoTools.currentWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "genoTools.showReport",
          "when": "view == genoTools.workspaces",
          "group": "navigation@3"
        },
        {
          "command": "genoTools.refreshWorkspaces",
          "when": "view == genoTools.remoteMirrors",
          "group": "navigation@2"
        },
        {
          "command": "genoTools.manageDispatches",
          "when": "view == genoTools.workspaces || view == genoTools.currentWorkspace || view == genoTools.remoteMirrors",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "genoTools.createRepo",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == repoGroup",
          "group": "inline@1"
        },
        {
          "command": "genoTools.createTmuxSession",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == tmuxSessionGroup",
          "group": "inline@1"
        },
        {
          "command": "genoTools.refreshTerminals",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == terminalGroup",
          "group": "inline@1"
        },
        {
          "command": "genoTools.recoverTerminalInTmux",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == terminal",
          "group": "inline@1"
        },
        {
          "command": "genoTools.openWorkspace",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == workspace",
          "group": "inline@2"
        },
        {
          "command": "genoTools.openWorkspaceInNewWindow",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == workspace",
          "group": "inline@3"
        },
        {
          "command": "genoTools.openRepo",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == repo",
          "group": "inline@1"
        },
        {
          "command": "genoTools.openTmuxSession",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && (viewItem == tmuxSession.live || viewItem == tmuxSession.external)",
          "group": "inline@1"
        },
        {
          "command": "genoTools.manageTmuxSession",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == tmuxSession.external",
          "group": "inline@2"
        },
        {
          "command": "genoTools.restoreTmuxSession",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == tmuxSession.stopped",
          "group": "inline@1"
        },
        {
          "command": "genoTools.deleteTmuxSession",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && (viewItem == tmuxSession.live || viewItem == tmuxSession.stopped)",
          "group": "inline@2"
        },
        {
          "command": "genoTools.refreshWorkspaces",
          "when": "view == genoTools.workspaces && viewItem == host",
          "group": "inline@2"
        },
        {
          "command": "genoTools.createWorkspace",
          "when": "view == genoTools.workspaces && viewItem == host",
          "group": "navigation@1"
        },
        {
          "command": "genoTools.copyPath",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && (viewItem == workspace || viewItem == repo)",
          "group": "navigation@1"
        },
        {
          "command": "genoTools.createWorktree",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == workspace",
          "group": "worktrees@1"
        },
        {
          "command": "genoTools.listWorktrees",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == workspace",
          "group": "worktrees@2"
        },
        {
          "command": "genoTools.removeWorktree",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == workspace",
          "group": "worktrees@3"
        },
        {
          "command": "genoTools.mirrorWorkspace",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == workspace",
          "group": "inline@4"
        },
        {
          "command": "genoTools.dispatchWorkspace",
          "when": "(view == genoTools.workspaces || view == genoTools.currentWorkspace) && viewItem == workspace",
          "group": "remote@2"
        },
        {
          "command": "genoTools.dispatchMirror",
          "when": "view == genoTools.remoteMirrors && viewItem == remoteMirror",
          "group": "inline@1"
        },
        {
          "command": "genoTools.manageDispatches",
          "when": "view == genoTools.remoteMirrors && viewItem == remoteMirror",
          "group": "remote@2"
        }
      ]
    },
    "configuration": {
      "title": "Geno Tools",
      "properties": {
        "genoTools.ttPath": {
          "type": "string",
          "default": "tt",
          "description": "Path to the TT executable. The extension also checks ~/.local/bin/tt when the default is not on VS Code's PATH."
        },
        "genoTools.openInNewWindow": {
          "type": "boolean",
          "default": true,
          "description": "Open TT repositories in a new VS Code window. Workspace rows provide separate current-window and new-window actions."
        },
        "genoTools.agentModel": {
          "type": "string",
          "default": "",
          "description": "Optional model override for tmux recovery. When empty, use llm.model from the Geno agent config."
        },
        "genoTools.agentConfigPath": {
          "type": "string",
          "default": "~/.geno/config.yaml",
          "description": "Path to the Geno YAML config containing llm.endpoint, llm.model, llm.api_key_env, and llm.api."
        }
      }
    }
  },
  "dependencies": {
    "@openai/agents": "^0.17.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
